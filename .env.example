# Копия этого файла -> .env (файл .env не попадает в Git). Все параметры необязательны.

# ---- LLM (любой OpenAI-совместимый сервер: vLLM, SGLang, LM Studio, Ollama, ...) ----
# Без LLM приложение работает в режиме "поиск + извлекающий ответ".
LLM_PROVIDER=openai          # openai | anthropic | none
LLM_BASE_URL=                # напр. http://localhost:8000/v1  (vLLM)  или http://localhost:1234/v1 (LM Studio)
LLM_API_KEY=                 # для локальных серверов можно любой непустой текст
LLM_MODEL=                   # имя модели на сервере
# ANTHROPIC_API_KEY=         # если LLM_PROVIDER=anthropic (LLM_MODEL, напр. claude-sonnet-4-5)

# ---- Поиск ----
EMBED_MODEL=multilingual-e5-large   # multilingual-e5-large | multilingual-e5-small | off
RERANK_MODEL=bge-reranker-v2-m3     # bge-reranker-v2-m3 | jina-reranker-v2 | off

# ---- Сервер ----
HOST=127.0.0.1
PORT=8000
